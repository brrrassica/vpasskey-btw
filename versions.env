# shellcheck shell=bash
# Upstream pin for the passkey-tpm authenticator.
#
# Both install.sh and humans source this file, so every variable is assigned
# with `:=`: an already-exported PASSKEY_TPM_* variable wins, which keeps
# development overrides working. Keep REF and COMMIT in sync; install.sh
# refuses to build when the fetched ref does not resolve to COMMIT.

# Repository to clone.
: "${PASSKEY_TPM_REPO:=https://github.com/dangerousplay/passkey-tpm}"

# Tag, branch, or commit to fetch.
: "${PASSKEY_TPM_REF:=v0.1.0-beta.2}"

# Exact commit PASSKEY_TPM_REF must resolve to. This is the integrity check.
: "${PASSKEY_TPM_COMMIT:=1372cf428fb99bc80875a23195da494c926809fb}"
