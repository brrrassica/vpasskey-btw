+#[test]
+fn non_boolean_uv_option_is_cbor_unexpected_type() {
+    // `uv` was type-checked nowhere before 0.2.0: the option map was parsed only for `up`
+    // and `rk`, so `uv: 1` was silently accepted.
+    for (command, key) in [(cmd::MAKE_CREDENTIAL, 7), (cmd::GET_ASSERTION, 5)] {
+        let mut a = auth();
+        let bad = vec![(int(key), Value::Map(vec![(text("uv"), Value::Uint(1))]))];
+        let request = if command == cmd::MAKE_CREDENTIAL {
+            req(command, mc_params(bad))
+        } else {
+            req(command, ga_params(None, bad))
+        };
+        assert_eq!(
+            done(prep(&mut a, ALICE, &request)),
+            vec![status::CBOR_UNEXPECTED_TYPE],
+            "command {command:#04x}"
+        );
+    }
+}
