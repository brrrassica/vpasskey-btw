+// ---------------------------------------------------------------- M3.6 UV/PIN status matrix
+
+/// The `uv` option value as WebAuthn's `userVerification` maps to it:
+/// required → `true`, preferred → absent, discouraged → `false`.
+fn uv_option(key: i64, uv: Option<bool>) -> Vec<(Value, Value)> {
+    uv.map(|uv| vec![(int(key), Value::Map(vec![(text("uv"), Value::Bool(uv))]))])
+        .unwrap_or_default()
+}
+
+#[test]
+fn uv_option_required_preferred_and_discouraged_all_verify() {
+    // Every credential is created at credProtect level 3, so this authenticator always
+    // verifies the user; `uv: false` cannot lower that, which CTAP 2.1 §6.1.2/§6.2.2
+    // permits. All three WebAuthn settings must therefore produce the same prompt and the
+    // same UV flag in the response.
+    for uv in [Some(true), None, Some(false)] {
+        let mut a = auth();
+        let mc = req(cmd::MAKE_CREDENTIAL, mc_params(uv_option(7, uv)));
+        let step = prep(&mut a, ALICE, &mc);
+        assert!(matches!(&step, Step::NeedUv(_)), "makeCredential uv={uv:?}");
+        let resp = body(&touch(&mut a, ALICE, step));
+        let auth_data = get(&resp, 2).and_then(Value::as_bytes).unwrap();
+        assert_eq!(auth_data[32] & 0x04, 0x04, "uv={uv:?}: UV flag set");
+        let id = cred_id_from_auth_data(auth_data);
+
+        let ga = req(
+            cmd::GET_ASSERTION,
+            ga_params(Some(vec![descriptor(&id)]), uv_option(5, uv)),
+        );
+        let step = prep(&mut a, ALICE, &ga);
+        assert!(matches!(&step, Step::NeedUv(_)), "getAssertion uv={uv:?}");
+        let resp = body(&touch(&mut a, ALICE, step));
+        assert_eq!(
+            get(&resp, 2).and_then(Value::as_bytes).unwrap()[32] & 0x04,
+            0x04,
+            "uv={uv:?}: UV flag set"
+        );
+    }
+}
+
+#[test]
+fn uv_option_matrix_without_fingerprint_or_pin() {
+    // No fingerprint and no PIN: nothing can satisfy UV, so both commands refuse before any
+    // prompt whatever `uv` says — the option can only ask for more, never less.
+    for uv in [Some(true), None, Some(false)] {
+        let mut a = auth();
+        let mc = req(cmd::MAKE_CREDENTIAL, mc_params(uv_option(7, uv)));
+        let ga = req(cmd::GET_ASSERTION, ga_params(None, uv_option(5, uv)));
+        assert_eq!(
+            done(a.prepare(ALICE, NO_READER, &mc, 0)),
+            vec![status::NOT_ALLOWED],
+            "makeCredential uv={uv:?}"
+        );
+        assert_eq!(
+            done(a.prepare(ALICE, NO_READER, &ga, 0)),
+            vec![status::NOT_ALLOWED],
+            "getAssertion uv={uv:?}"
+        );
+
+        // With a PIN set the platform must authenticate with it instead.
+        set_pin(&mut a, ALICE, Protocol::Two);
+        assert_eq!(
+            done(a.prepare(ALICE, NO_READER, &mc, 0)),
+            vec![status::PUAT_REQUIRED],
+            "makeCredential uv={uv:?}"
+        );
+        assert_eq!(
+            done(a.prepare(ALICE, NO_READER, &ga, 0)),
+            vec![status::PUAT_REQUIRED],
+            "getAssertion uv={uv:?}"
+        );
+    }
+}
