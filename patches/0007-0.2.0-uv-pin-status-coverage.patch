+#[test]
+fn status_codes_match_ctap_21_section_8_2() {
+    // These values are the wire contract with every CTAP client; a typo here is a silent
+    // protocol break, so the whole table is pinned rather than trusted to review.
+    for (code, name, expected) in [
+        (status::OK, "CTAP2_OK", 0x00u8),
+        (status::INVALID_COMMAND, "CTAP1_ERR_INVALID_COMMAND", 0x01),
+        (
+            status::INVALID_PARAMETER,
+            "CTAP1_ERR_INVALID_PARAMETER",
+            0x02,
+        ),
+        (status::INVALID_LENGTH, "CTAP1_ERR_INVALID_LENGTH", 0x03),
+        (
+            status::CBOR_UNEXPECTED_TYPE,
+            "CTAP2_ERR_CBOR_UNEXPECTED_TYPE",
+            0x11,
+        ),
+        (status::INVALID_CBOR, "CTAP2_ERR_INVALID_CBOR", 0x12),
+        (
+            status::MISSING_PARAMETER,
+            "CTAP2_ERR_MISSING_PARAMETER",
+            0x14,
+        ),
+        (status::LIMIT_EXCEEDED, "CTAP2_ERR_LIMIT_EXCEEDED", 0x15),
+        (
+            status::CREDENTIAL_EXCLUDED,
+            "CTAP2_ERR_CREDENTIAL_EXCLUDED",
+            0x19,
+        ),
+        (
+            status::UNSUPPORTED_ALGORITHM,
+            "CTAP2_ERR_UNSUPPORTED_ALGORITHM",
+            0x26,
+        ),
+        (status::OPERATION_DENIED, "CTAP2_ERR_OPERATION_DENIED", 0x27),
+        (status::KEY_STORE_FULL, "CTAP2_ERR_KEY_STORE_FULL", 0x28),
+        (
+            status::UNSUPPORTED_OPTION,
+            "CTAP2_ERR_UNSUPPORTED_OPTION",
+            0x2B,
+        ),
+        (status::INVALID_OPTION, "CTAP2_ERR_INVALID_OPTION", 0x2C),
+        (status::KEEPALIVE_CANCEL, "CTAP2_ERR_KEEPALIVE_CANCEL", 0x2D),
+        (status::NO_CREDENTIALS, "CTAP2_ERR_NO_CREDENTIALS", 0x2E),
+        (
+            status::USER_ACTION_TIMEOUT,
+            "CTAP2_ERR_USER_ACTION_TIMEOUT",
+            0x2F,
+        ),
+        (status::NOT_ALLOWED, "CTAP2_ERR_NOT_ALLOWED", 0x30),
+        (status::PIN_INVALID, "CTAP2_ERR_PIN_INVALID", 0x31),
+        (status::PIN_BLOCKED, "CTAP2_ERR_PIN_BLOCKED", 0x32),
+        (status::PIN_AUTH_INVALID, "CTAP2_ERR_PIN_AUTH_INVALID", 0x33),
+        (status::PIN_AUTH_BLOCKED, "CTAP2_ERR_PIN_AUTH_BLOCKED", 0x34),
+        (status::PIN_NOT_SET, "CTAP2_ERR_PIN_NOT_SET", 0x35),
+        (status::PUAT_REQUIRED, "CTAP2_ERR_PUAT_REQUIRED", 0x36),
+        (
+            status::PIN_POLICY_VIOLATION,
+            "CTAP2_ERR_PIN_POLICY_VIOLATION",
+            0x37,
+        ),
+        (status::UV_BLOCKED, "CTAP2_ERR_UV_BLOCKED", 0x3C),
+        (
+            status::INVALID_SUBCOMMAND,
+            "CTAP2_ERR_INVALID_SUBCOMMAND",
+            0x3E,
+        ),
+        (status::UV_INVALID, "CTAP2_ERR_UV_INVALID", 0x3F),
+        (
+            status::UNAUTHORIZED_PERMISSION,
+            "CTAP2_ERR_UNAUTHORIZED_PERMISSION",
+            0x40,
+        ),
+        (status::OTHER, "CTAP1_ERR_OTHER", 0x7F),
+    ] {
+        assert_eq!(code, expected, "{name}");
+    }
+}
