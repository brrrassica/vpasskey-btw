+#[test]
+fn pin_status_matrix() {
+    // No PIN set: the platform is told to set one first.
+    let mut a = auth();
+    let p = Platform::new(&mut a, ALICE, Protocol::Two);
+    assert_eq!(
+        done(prep(&mut a, ALICE, &p.token_using_pin(PIN, 0x03, Some(RP)),)),
+        vec![status::PIN_NOT_SET]
+    );
+
+    // Consecutive wrong PINs: PIN_INVALID while attempts remain, then PIN_AUTH_BLOCKED for
+    // the rest of this "power cycle" (MAX_BOOT_MISMATCHES, CTAP 2.1 §6.5.5.7.2).
+    set_pin(&mut a, ALICE, Protocol::Two);
+    let mut seen = Vec::new();
+    for _ in 0..MAX_BOOT_MISMATCHES {
+        let p = Platform::new(&mut a, ALICE, Protocol::Two);
+        seen.push(
+            done(prep(
+                &mut a,
+                ALICE,
+                &p.token_using_pin(b"000000", 0x03, Some(RP)),
+            ))[0],
+        );
+    }
+    assert_eq!(
+        seen,
+        vec![
+            status::PIN_INVALID,
+            status::PIN_INVALID,
+            status::PIN_AUTH_BLOCKED
+        ]
+    );
+
+    // A TPM-wide DA lockout is temporary and refunds the attempt.
+    let mut a = auth();
+    set_pin(&mut a, ALICE, Protocol::Two);
+    let p = Platform::new(&mut a, ALICE, Protocol::Two);
+    a.tpm_mut().verify_error = Some(TpmError::Lockout);
+    assert_eq!(
+        done(prep(&mut a, ALICE, &p.token_using_pin(PIN, 0x03, Some(RP)),)),
+        vec![status::PIN_AUTH_BLOCKED]
+    );
+    assert_eq!(a.tpm_mut().pin_retries(ALICE).unwrap(), MAX_PIN_RETRIES);
+
+    // Zero persisted retries outranks the boot mismatch counter: PIN_BLOCKED even with the
+    // right PIN, until the authenticator is reset.
+    let mut a = auth();
+    set_pin(&mut a, ALICE, Protocol::Two);
+    let p = Platform::new(&mut a, ALICE, Protocol::Two);
+    a.tpm_mut().retries.insert(ALICE.0, 0);
+    assert_eq!(
+        done(prep(&mut a, ALICE, &p.token_using_pin(PIN, 0x03, Some(RP)),)),
+        vec![status::PIN_BLOCKED]
+    );
+}
