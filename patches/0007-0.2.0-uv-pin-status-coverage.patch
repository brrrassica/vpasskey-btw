+#[test]
+fn token_permission_errors_before_a_token_exists() {
+    let mut a = auth();
+    // Zero permissions is an invalid parameter, not an authorization failure.
+    let p = Platform::new(&mut a, ALICE, Protocol::Two);
+    assert_eq!(
+        done(prep(&mut a, ALICE, &p.token_using_uv(0x00, RP))),
+        vec![status::INVALID_PARAMETER]
+    );
+    // A permission bit this authenticator cannot grant (bioEnrollment, 0x40 here) is
+    // refused at issuance; no token is handed out. The status is pinned as-is so a future
+    // change is deliberate.
+    let p = Platform::new(&mut a, ALICE, Protocol::Two);
+    assert_eq!(
+        done(prep(&mut a, ALICE, &p.token_using_uv(0x40, RP))),
+        vec![status::UNAUTHORIZED_PERMISSION]
+    );
+    // At command time, a token that lacks the needed permission is PIN_AUTH_INVALID
+    // (CTAP 2.1 §6.1.2 step 9), already covered by the RP-binding test below.
+}
